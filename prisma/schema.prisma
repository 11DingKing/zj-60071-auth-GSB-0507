generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionType {
  MENU
  BUTTON
  API
}

enum DataScope {
  ALL
  DEPT_AND_CHILDREN
  DEPT_ONLY
  SELF
}

model Tenant {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  config      Json      @default("{}")
  isEnabled   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users         User[]
  departments   Department[]
  roles         Role[]
  permissions   Permission[]
  invitationCodes InvitationCode[]

  @@index([code])
}

model InvitationCode {
  id          String    @id @default(uuid())
  code        String    @unique
  tenantId    String
  isUsed      Boolean   @default(false)
  usedById    String?
  usedAt      DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usedBy  User?   @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([tenantId])
}

model Department {
  id          String    @id @default(uuid())
  name        String
  code        String?
  tenantId    String
  parentId    String?
  sort        Int       @default(0)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent    Department? @relation("DepartmentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentChildren")
  users     User[]

  @@index([tenantId])
  @@index([parentId])
}

model User {
  id           String    @id @default(uuid())
  username     String
  password     String
  email        String?
  phone        String?
  tenantId     String
  departmentId String?
  isEnabled    Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  userRoles    UserRole[]
  usedInvitations InvitationCode[]

  @@unique([username, tenantId])
  @@index([tenantId])
  @@index([departmentId])
}

model Role {
  id           String    @id @default(uuid())
  name         String
  code         String
  tenantId     String
  parentId     String?
  description  String?
  dataScope    DataScope @default(SELF)
  sort         Int       @default(0)
  isEnabled    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent         Role?         @relation("RoleChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children       Role[]        @relation("RoleChildren")
  rolePermissions RolePermission[]
  userRoles      UserRole[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([parentId])
}

model Permission {
  id          String         @id @default(uuid())
  name        String
  code        String
  tenantId    String
  parentId    String?
  type        PermissionType
  path        String?
  method      String?
  icon        String?
  sort        Int            @default(0)
  description String?
  isEnabled   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent          Permission?        @relation("PermissionChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        Permission[]       @relation("PermissionChildren")
  rolePermissions RolePermission[]

  @@unique([code, tenantId])
  @@index([tenantId])
  @@index([parentId])
  @@index([type])
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime  @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model OperationLog {
  id          String    @id @default(uuid())
  tenantId    String
  userId      String
  username    String
  module      String
  operation   String
  method      String
  path        String
  params      String?
  result      String?
  ip          String?
  userAgent   String?
  status      Int
  errorMsg    String?
  duration    Int
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
  @@index([module])
}
